rules_version = '2';

// Regole di sicurezza di ContaCalorie.
// Ogni utente può leggere e scrivere SOLO i documenti sotto users/{uid}
// dove {uid} è il proprio uid autenticato. Tutto il resto è negato.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper generici ----------
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isNumIn(v, min, max) {
      return v is number && v >= min && v <= max;
    }

    function isStrLen(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function isOptStr(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    function isDateStr(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Valori per 100 g (alimenti e voci): kcal 0-1000 (il grasso puro ne ha ~900), macro 0-100 g.
    function isPer100(n) {
      return n is map
        && n.keys().hasAll(['kcal', 'protein', 'carbs', 'fat'])
        && n.keys().hasOnly(['kcal', 'protein', 'carbs', 'fat'])
        && isNumIn(n.kcal, 0, 1000)
        && isNumIn(n.protein, 0, 100)
        && isNumIn(n.carbs, 0, 100)
        && isNumIn(n.fat, 0, 100);
    }

    // createdAt è l'orario del server alla creazione e poi non cambia. Una scrittura completa fatta
    // offline su un documento già esistente (vince l'ultima scrittura) può reimpostarlo all'orario attuale.
    function createdAtOk() {
      return request.resource.data.createdAt == request.time
        || (resource != null && request.resource.data.createdAt == resource.data.createdAt);
    }

    // ---------- Tutorial di benvenuto: campo users/{uid}.tutorial ----------
    // completedAt è l'orario del server quando viene salvato; nelle scritture successive del profilo
    // (merge) resta il valore già memorizzato, quindi basta che sia un timestamp.
    function isValidTutorial(t) {
      return t is map
        && t.keys().hasAll(['completed', 'version', 'skipped'])
        && t.keys().hasOnly(['completed', 'completedAt', 'version', 'skipped'])
        && t.completed is bool
        && t.skipped is bool
        && t.version is int && t.version >= 1 && t.version <= 1000
        && (t.get('completedAt', null) == null || t.completedAt is timestamp);
    }

    // ---------- Profilo: users/{uid} ----------
    function isValidProfile(d) {
      return d.keys().hasOnly([
          'displayName', 'sex', 'age', 'heightCm', 'weightKg', 'activityLevel', 'goal',
          'kcalTarget', 'kcalManual', 'proteinTarget', 'carbsTarget', 'fatTarget',
          'onboarded', 'tutorial', 'createdAt', 'updatedAt'
        ])
        && isOptStr(d.get('displayName', null), 100)
        && d.get('sex', 'male') in ['male', 'female']
        && isNumIn(d.get('age', 30), 10, 120)
        && isNumIn(d.get('heightCm', 170), 50, 260)
        && isNumIn(d.get('weightKg', 70), 20, 400)
        && d.get('activityLevel', 'moderate') in ['sedentary', 'light', 'moderate', 'active', 'very_active']
        && d.get('goal', 'maintain') in ['lose', 'maintain', 'gain']
        && isNumIn(d.get('kcalTarget', 2000), 500, 10000)
        && d.get('kcalManual', false) is bool
        && isNumIn(d.get('proteinTarget', 0), 0, 1000)
        && isNumIn(d.get('carbsTarget', 0), 0, 2000)
        && isNumIn(d.get('fatTarget', 0), 0, 1000)
        && d.get('onboarded', true) is bool
        && (!('tutorial' in d) || isValidTutorial(d.tutorial))
        && d.get('createdAt', request.time) is timestamp
        && d.get('updatedAt', request.time) == request.time;
    }

    // ---------- Voce di diario: users/{uid}/entries/{entryId} ----------
    function isValidEntry(d) {
      return d.keys().hasAll(['date', 'mealType', 'name', 'grams', 'kcal', 'protein', 'carbs', 'fat', 'per100', 'source', 'createdAt'])
        && d.keys().hasOnly(['date', 'mealType', 'name', 'brand', 'grams', 'kcal', 'protein', 'carbs', 'fat', 'per100', 'source', 'foodId', 'barcode', 'createdAt', 'updatedAt'])
        && isDateStr(d.date)
        && d.mealType in ['breakfast', 'lunch', 'dinner', 'snack']
        && isStrLen(d.name, 1, 200)
        && isOptStr(d.get('brand', null), 200)
        && isOptStr(d.get('foodId', null), 100)
        && isOptStr(d.get('barcode', null), 50)
        && isNumIn(d.grams, 0, 10000)
        && isNumIn(d.kcal, 0, 100000)
        && isNumIn(d.protein, 0, 10000)
        && isNumIn(d.carbs, 0, 10000)
        && isNumIn(d.fat, 0, 10000)
        && isPer100(d.per100)
        && d.source in ['off', 'usda', 'manual', 'custom', 'recipe']
        && createdAtOk()
        && d.get('updatedAt', request.time) == request.time;
    }

    // ---------- I miei alimenti / ricette: users/{uid}/foods/{foodId} ----------
    // L'id è la chiave dell'alimento: per i prodotti scansionati è il codice a barre (niente doppioni).
    function isValidFood(d, foodId) {
      return d.keys().hasAll(['name', 'per100', 'defaultGrams', 'favorite', 'kind', 'createdAt'])
        && d.keys().hasOnly([
          'name', 'brand', 'barcode', 'per100', 'defaultGrams', 'servingGrams', 'favorite', 'kind', 'ingredients',
          'source', 'type', 'origin', 'useCount', 'lastUsedAt', 'createdAt', 'updatedAt'
        ])
        && foodId.size() <= 100
        && isStrLen(d.name, 1, 200)
        && isOptStr(d.get('brand', null), 200)
        && (d.get('barcode', null) == null || (d.barcode is string && d.barcode.matches('^[0-9]{6,14}$')))
        && isPer100(d.per100)
        && isNumIn(d.defaultGrams, 0, 10000)
        && (d.get('servingGrams', null) == null || isNumIn(d.servingGrams, 0, 5000))
        && d.favorite is bool
        && d.kind in ['food', 'recipe']
        && (d.get('ingredients', []) is list && d.get('ingredients', []).size() <= 60)
        && d.get('source', 'manual') in ['off', 'usda', 'manual', 'custom', 'recipe']
        && d.get('type', 'custom') in ['packaged', 'generic', 'custom', 'recipe']
        && d.get('origin', 'manual') in ['scan', 'search', 'manual', 'recipe']
        // Un prodotto scansionato è salvato con il suo codice a barre come id.
        && (d.get('origin', 'manual') != 'scan' || foodId == d.get('barcode', ''))
        && (d.get('useCount', 0) is int && d.get('useCount', 0) >= 0 && d.get('useCount', 0) <= 1000000)
        && d.get('lastUsedAt', request.time) is timestamp
        && createdAtOk()
        && d.get('updatedAt', request.time) == request.time;
    }

    // ---------- Codici scansionati offline da completare: users/{uid}/pendingScans/{barcode} ----------
    function isValidPendingScan(d, code) {
      return d.keys().hasAll(['barcode', 'status', 'createdAt'])
        && d.keys().hasOnly(['barcode', 'status', 'createdAt', 'updatedAt'])
        && code.matches('^[0-9]{6,14}$')
        && d.barcode == code
        && d.status in ['pending', 'not_found']
        && createdAtOk()
        && d.get('updatedAt', request.time) == request.time;
    }

    // ---------- Peso: users/{uid}/weights/{date} (id del documento = data) ----------
    function isValidWeight(d, date) {
      return d.keys().hasOnly(['date', 'kg', 'updatedAt'])
        && isDateStr(date)
        && d.date == date
        && isNumIn(d.kg, 20, 400)
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidProfile(request.resource.data);

      match /entries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidEntry(request.resource.data);
      }

      match /foods/{foodId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidFood(request.resource.data, foodId);
      }

      match /pendingScans/{code} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidPendingScan(request.resource.data, code);
      }

      match /weights/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidWeight(request.resource.data, date);
      }
    }

    // Qualsiasi altro percorso è vietato.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

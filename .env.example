# Copia questo file in `.env` (non committarlo!) e inserisci i valori
# presi da Firebase Console → Impostazioni progetto → Le tue app → Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Chiave gratuita USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup).
# Se vuota l'app usa DEMO_KEY, con limiti molto bassi.
VITE_USDA_API_KEY=
